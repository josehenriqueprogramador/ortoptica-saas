# --- CONFIGURAÇÕES DE REDE & PORTAS ---
API_PORT=8000
FRONTEND_PORT=5173

# --- AMBIENTE ---
ENV=development

# --- BANCO DE DADOS (SQLite Assíncrono no Docker) ---
DATABASE_URL=sqlite+aiosqlite:///app/ortoptica.db

